; USEFUL LEARNING -- fit the behavior toward target 3 by in-language GRAD on the
; operand @w. eta (0.1), the target (M[0]), the loss (SUB/SQ/LOSS), the loop
; (counter in M[1] + JZ/JMP), and where GRAD fires all live in this program.
        LOADI 3
        ST 0            ; M[0] = target 3
        LOADI 8
        ST 1            ; M[1] = pass counter
loop:   LOADI 0.0 @w    ; r0 = w  (init 0, the learnable behavior)
        OUT             ; emit behavior -> 0, .6, 1.08, ... (v_{n+1}=.8 v_n + .6)
        SUB 0           ; r0 = w - target
        SQ              ; r0 = (w-target)^2
        LOSS            ; L += r0
        GRAD @w 0.1     ; w -= 0.1 * dL/dw
        LD 1
        ADD -1
        ST 1
        JZ end
        JMP loop
end:    HALT
